generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  role Role
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

enum Role {
  ADMIN
  EMPLOYEE
}

model Room {
  id Int @id @default(autoincrement())
  name String @unique
  status RoomStatus @default(AVAILABLE)
  capacity Int?
  Amenities String[]
  bookings Booking[]
  maintenanceStart DateTime?
  maintenanceEnd DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RoomStatus {
  AVAILABLE
  MAINTANENCE
  OCCUPIED
}

model Booking {
  id Int @id @default(autoincrement())
  userId Int
  roomId Int
  startTime DateTime
  endTime DateTime
  status BookingStatus
  meetingDescription String?
  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])
}

enum BookingStatus {
  UPCOMING
  CANCELED
  COMPLETED
  ONGOING
}



